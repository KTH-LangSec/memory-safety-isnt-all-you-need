p := 1; q := 2; true := 1; dangerous := 67;

shared <- alloc_C;
shared[p] := true;
shared[q] := dangerous;


fn g {
	// Call flow->Fetch->Data flow
	y := shared[I_2];

	// Data flow->SInk
	Sink := y
}

// Data->Fetch->Data flow
x := shared[I_1];

// Data flow->Control flow
if x == true {
	// Control flow->Call flow
	call g
} else {
	skip
}
