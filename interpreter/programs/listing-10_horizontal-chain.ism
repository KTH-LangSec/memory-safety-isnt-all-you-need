x := nil; t := obj1;
while (x == nil) && (t != nil) { x := t[I_1]; t := t[__proto__] }

// `if (x) { ... }'
if x == true {
	// `var y = obj2[i2]'
	y := nil; t := obj2;
	while (y == nil) && (t != nil) { y := t[I_2]; t := t[__proto__] }

