p := 1; true := 1; benign := 42; dangerous := 67;

shared <- alloc_C;
shared[p] := true;


fn f {
	// Call flow->Data flow
	g := h
}
fn g {
	Sink := benign
}
fn h {
	// Call flow->Sink
	Sink := dangerous
}

// Data->Fetch->Data flow
x := shared[I_1];

// Data flow->Control flow
if x == true {
	// Control flow->Call flow
	call f
} else {
	skip
}

// Data flow->Call flow
call g
