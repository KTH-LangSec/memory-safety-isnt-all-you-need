p := 1; true := 1; benign := 42; dangerous := 67;

shared <- alloc_C;
shared[p] := true;


fn f {
	y := benign
}
fn g {
	y := dangerous
}

// Data->Fetch->Data flow
x := shared[I_1];

// Data flow->Control flow
if x == true {
	// Control flow->Data flow
	f := g
} else {
	skip
}

// Data flow->Call flow->Data flow
call f;

// Data flow->Sink
Sink := y
