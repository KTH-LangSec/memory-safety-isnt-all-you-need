p := 1; true := 1; dangerous := 67;

shared <- alloc_C;
shared[p] := true;


fn f {
	// Call flow->Sink
	Sink := dangerous
}

// Data->Fetch->Data flow
x := shared[I_1];

// Data flow->Control flow
if x == true {
	// Control flow->Call flow
	call f
} else {
	skip
}
